# =========================================================
# PHONIX IT SOLUTIONS — SERVER CONFIGURATION & ERROR PAGES
# Works seamlessly on cPanel, LiteSpeed & Apache Web Servers
# =========================================================

# 1. CLEAN URLS (REMOVING .HTML EXTENSION FROM ADDRESS BAR)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /index.html or /index to root /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?[\s?] [NC]
  RewriteRule ^(.*)index(\.html)?$ /$1 [R=301,L]

  # Redirect external request from /page.html to clean URL /page (Permanent 301)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # Internally resolve clean URL /page to page.html if the file exists
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^\.]+)$ $1.html [NC,L]
</IfModule>

# 2. CUSTOM BRANDED ERROR PAGES
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 403 /403.html

# 3. DEFAULT INDEX FILE
DirectoryIndex index.html

# 4. GZIP COMPRESSION (Fast Load Speeds)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

# 5. BROWSER CACHING FOR ASSETS & MEDIA
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 6. SECURITY HEADERS
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
